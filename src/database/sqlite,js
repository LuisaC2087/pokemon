
import * as SQLite from 'expo-sqlite';
import * as Crypto from 'expo-crypto';

const dbPromise = SQLite.openDatabaseAsync('profesores.db');

export async function initDatabase() {
  const db = await dbPromise;

  await db.execAsync(`
    PRAGMA journal_mode = WAL;

    CREATE TABLE IF NOT EXISTS profesores_local (
      id TEXT PRIMARY KEY NOT NULL,
      nombre TEXT NOT NULL,
      departamento TEXT NOT NULL,
      datos TEXT NOT NULL DEFAULT '{}',
      actualizado_en TEXT NOT NULL,
      sincronizado INTEGER NOT NULL DEFAULT 0,
      eliminado INTEGER NOT NULL DEFAULT 0
    );

    CREATE TABLE IF NOT EXISTS operaciones_pendientes (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      profesor_id TEXT NOT NULL,
      operacion TEXT NOT NULL,
      payload TEXT NOT NULL,
      creado_en TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      UNIQUE(profesor_id)
    );
  `);

  return true;
}

export async function listarProfesores() {
  const db = await dbPromise;

  return db.getAllAsync(`
    SELECT id, nombre, departamento, datos, actualizado_en
    FROM profesores_local
    WHERE eliminado = 0
    ORDER BY nombre
  `).then(rows =>
    rows.map(row => ({
      ...row,
      ...JSON.parse(row.datos || '{}')
    }))
  );
}

export async function obtenerProfesor(id) {
  const db = await dbPromise;

  const row = await db.getFirstAsync(
    `SELECT * FROM profesores_local
     WHERE id = ? AND eliminado = 0`,
    id
  );

  if (!row) return null;

  return {
    ...row,
    ...JSON.parse(row.datos || '{}')
  };
}

export async function guardarProfesor(profesor) {
  const db = await dbPromise;

  if (!profesor.nombre?.trim() ||
      !profesor.departamento?.trim()) {
    throw new Error('Nombre y departamento son obligatorios');
  }

  const id = profesor.id || Crypto.randomUUID();
  const anterior = await db.getFirstAsync(
    'SELECT * FROM profesores_local WHERE id = ?',
    id
  );

  const datos = { ...(anterior
    ? JSON.parse(anterior.datos || '{}')
    : {}), ...profesor };

  delete datos.id;
  delete datos.nombre;
  delete datos.departamento;
  delete datos.actualizado_en;
  delete datos.sincronizado;
  delete datos.eliminado;

  const actualizadoEn = new Date().toISOString();

  const registro = {
    id,
    nombre: profesor.nombre.trim(),
    departamento: profesor.departamento.trim(),
    datos: JSON.stringify(datos),
    actualizado_en: actualizadoEn
  };

  await db.withTransactionAsync(async () => {
    await db.runAsync(
      `INSERT INTO profesores_local
       (id, nombre, departamento, datos, actualizado_en,
        sincronizado, eliminado)
       VALUES (?, ?, ?, ?, ?, 0, 0)
       ON CONFLICT(id) DO UPDATE SET
         nombre = excluded.nombre,
         departamento = excluded.departamento,
         datos = excluded.datos,
         actualizado_en = excluded.actualizado_en,
         sincronizado = 0,
         eliminado = 0`,
      registro.id,
      registro.nombre,
      registro.departamento,
      registro.datos,
      registro.actualizado_en
    );

    const pendiente = await db.getFirstAsync(
      `SELECT operacion FROM operaciones_pendientes
       WHERE profesor_id = ?`,
      id
    );

    const operacion = pendiente?.operacion === 'crear'
      ? 'crear'
      : anterior?.sincronizado === 1
        ? 'actualizar'
        : 'crear';

    await db.runAsync(
      `INSERT INTO operaciones_pendientes
       (profesor_id, operacion, payload)
       VALUES (?, ?, ?)
       ON CONFLICT(profesor_id) DO UPDATE SET
         operacion = excluded.operacion,
         payload = excluded.payload,
         creado_en = CURRENT_TIMESTAMP`,
      id,
      operacion,
      JSON.stringify({ ...registro, datos })
    );
  });

  return { ...registro, ...datos };
}

export async function eliminarProfesor(id) {
  const db = await dbPromise;

  const profesor = await db.getFirstAsync(
    'SELECT * FROM profesores_local WHERE id = ?',
    id
  );

  if (!profesor) return false;

  await db.withTransactionAsync(async () => {
    const pendiente = await db.getFirstAsync(
      `SELECT operacion FROM operaciones_pendientes
       WHERE profesor_id = ?`,
      id
    );

    if (pendiente?.operacion === 'crear' ||
        profesor.sincronizado === 0) {
      await db.runAsync(
        'DELETE FROM operaciones_pendientes WHERE profesor_id = ?',
        id
      );

      await db.runAsync(
        'DELETE FROM profesores_local WHERE id = ?',
        id
      );
    } else {
      await db.runAsync(
        `UPDATE profesores_local
         SET eliminado = 1, sincronizado = 0
         WHERE id = ?`,
        id
      );

      await db.runAsync(
        `INSERT INTO operaciones_pendientes
         (profesor_id, operacion, payload)
         VALUES (?, 'eliminar', ?)
         ON CONFLICT(profesor_id) DO UPDATE SET
           operacion = 'eliminar',
           payload = excluded.payload,
           creado_en = CURRENT_TIMESTAMP`,
        id,
        JSON.stringify({ id })
      );
    }
  });

  return true;
}

export async function listarPendientes() {
  const db = await dbPromise;

  return db.getAllAsync(
    `SELECT * FROM operaciones_pendientes ORDER BY id`
  );
}
